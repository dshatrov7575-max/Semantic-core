     "then": {
      "required": [
       "cancelled_at"
      ],
      "not": {
       "anyOf": [
        {
         "required": [
          "completed_at"
         ]
        },
        {
         "required": [
          "overall_risk"
         ]
        }
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "IN_PROGRESS"
       }
      }
     },
     "then": {
      "not": {
       "anyOf": [
        {
         "required": [
          "completed_at"
         ]
        },
        {
         "required": [
          "overall_risk"
         ]
        },
        {
         "required": [
          "cancelled_at"
         ]
        }
       ]
