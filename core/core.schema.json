{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:as:core-ontology:0.3",
 "title": "Архитектура семантики — онтология ядра v0.3 (dataset)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "dataset_format",
  "ontology_version",
  "records"
 ],
 "properties": {
  "dataset_format": {
   "const": "core-dataset/0.3"
  },
  "ontology_version": {
   "const": "core-ontology/0.3"
  },
  "records": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/Record"
   }
  }
 },
 "$defs": {
  "ProjectId": {
   "type": "string",
   "pattern": "^prj_[a-z0-9_]{2,64}$"
  },
  "TenantId": {
   "type": "string",
   "pattern": "^tnt_[a-z0-9_]{2,64}$"
  },
  "EntityId": {
   "type": "string",
   "pattern": "^ent_[a-z0-9_]{2,64}$"
  },
  "SourceId": {
   "type": "string",
   "pattern": "^src:sha256:[0-9a-f]{64}$"
  },
  "ClaimId": {
   "type": "string",
   "pattern": "^clm:sha256:[0-9a-f]{64}$"
  },
  "ReceiptId": {
   "type": "string",
   "pattern": "^rcp:sha256:[0-9a-f]{64}$"
  },
  "CheckId": {
   "type": "string",
   "pattern": "^chk_[a-z0-9_]{2,64}$"
  },
  "ReviewId": {
   "type": "string",
   "pattern": "^rev_[a-z0-9_]{2,64}$"
  },
  "KeyId": {
   "type": "string",
   "pattern": "^key_[a-z0-9_]{2,64}$"
  },
  "ServiceId": {
   "type": "string",
   "pattern": "^svc_[a-z0-9_]{2,64}$"
  },
  "ActorId": {
   "type": "string",
   "pattern": "^(usr|svc)_[a-z0-9_]{2,64}$"
  },
  "UserId": {
   "type": "string",
   "pattern": "^usr_[a-z0-9_]{2,64}$"
  },
  "RunId": {
   "type": "string",
   "pattern": "^run_[a-z0-9_]{2,64}$"
  },
  "Sha256Hex": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "Timestamp": {
   "type": "string",
   "format": "date-time",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
  },
  "Date": {
   "type": "string",
   "format": "date",
   "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
  },
  "NonEmpty": {
   "type": "string",
   "minLength": 1,
   "maxLength": 2000,
   "pattern": "\\S"
  },
  "Product": {
   "enum": [
    "TECHSENSE",
    "CONFLICTOLOGY",
    "WEB_MONITORING",
    "DOSSIER",
    "COMPLIANCE",
    "SEMANTIC_WIKI"
   ]
  },
  "EntityType": {
   "enum": [
    "PERSON",
    "ORGANIZATION",
    "REAL_ESTATE",
    "MOVABLE_PROPERTY",
    "EVENT",
    "CONFLICT",
    "EQUIPMENT",
    "EQUIPMENT_MODEL",
    "CONCEPT",
    "THING"
   ]
  },
  "Dimension": {
   "enum": [
    "NEGATIVE",
    "TENDERS",
    "SOCIAL_MEDIA",
    "CORPORATE",
    "PROPERTY",
    "COURT"
   ]
  },
  "Risk": {
   "enum": [
    "NONE",
    "LOW",
    "MEDIUM",
    "HIGH"
   ]
  },
  "Marking": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "level",
    "categories"
   ],
   "properties": {
    "level": {
     "enum": [
      "PUBLIC",
      "INTERNAL",
      "CONFIDENTIAL",
      "RESTRICTED"
     ]
    },
    "categories": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "enum": [
       "PERSONAL_DATA",
       "COMMERCIAL_SECRET",
       "OFFICIAL_USE"
      ]
     }
    }
   }
  },
  "Header": {
   "type": "object",
   "properties": {
    "schema_version": {
     "enum": [
      "core-ontology/0.2",
      "core-ontology/0.3"
     ]
    }
   },
   "required": [
    "kind",
    "schema_version"
   ]
  },
  "Record": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "Project",
      "Source",
      "Entity",
      "Claim",
      "ClaimReview",
      "Check",
      "ArtifactReceipt",
      "IdentityDecision",
      "Publication",
      "ClassDef",
      "LinkDef",
      "IdentifierDef"
     ]
    }
   },
   "allOf": [
    {
     "$ref": "#/$defs/Header"
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Project"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Project"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Source"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Source"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Entity"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Entity"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Claim"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Claim"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "ClaimReview"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/ClaimReview"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Check"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Check"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "ArtifactReceipt"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/ArtifactReceipt"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "IdentityDecision"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/IdentityDecision"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "Publication"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/Publication"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "ClassDef"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/ClassDef"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "LinkDef"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/LinkDef"
     }
    },
    {
     "if": {
      "properties": {
       "kind": {
        "const": "IdentifierDef"
       }
      }
     },
     "then": {
      "$ref": "#/$defs/IdentifierDef"
     }
    }
   ]
  },
  "Project": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "project_id",
    "tenant_id",
    "product",
    "title",
    "created_at",
    "default_marking"
   ],
   "properties": {
    "kind": {
     "const": "Project"
    },
    "schema_version": true,
    "project_id": {
     "$ref": "#/$defs/ProjectId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "product": {
     "$ref": "#/$defs/Product"
    },
    "title": {
     "$ref": "#/$defs/NonEmpty"
    },
    "created_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "default_marking": {
     "$ref": "#/$defs/Marking"
    }
   }
  },
  "Source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "source_id",
    "tenant_id",
    "source_kind",
    "media_type",
    "byte_length",
    "language",
    "title",
    "observations",
    "marking"
   ],
   "properties": {
    "kind": {
     "const": "Source"
    },
    "schema_version": true,
    "source_id": {
     "$ref": "#/$defs/SourceId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "source_kind": {
     "enum": [
      "DOCUMENT",
      "MEDIA_ARTICLE",
      "SOCIAL_POST",
      "REGISTRY_EXTRACT",
      "REGISTRY_SEARCH_RESULT",
      "WEB_PAGE",
      "ANALYST_NOTE"
     ]
    },
    "media_type": {
     "type": "string",
     "pattern": "^[a-z]+/[a-z0-9.+-]+(; ?charset=utf-8)?$"
    },
    "byte_length": {
     "type": "integer",
     "minimum": 0
    },
    "language": {
     "type": "string",
     "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "title": {
     "$ref": "#/$defs/NonEmpty"
    },
    "published_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "observations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "observed_at",
       "origin_uri",
       "observed_by"
      ],
      "properties": {
       "observed_at": {
        "$ref": "#/$defs/Timestamp"
       },
       "origin_uri": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9+.-]*:\\S+$"
       },
       "observed_by": {
        "$ref": "#/$defs/ActorId"
       },
       "original": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "object",
         "media_type",
         "byte_length"
        ],
        "properties": {
         "object": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
         },
         "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+(; ?charset=[a-z0-9-]+)?$"
         },
         "byte_length": {
          "type": "integer",
          "minimum": 1
         }
        }
       }
      }
     }
    },
    "content_inline": {
     "type": "string"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    }
   }
  },
  "Entity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "entity_id",
    "project_id",
    "entity_type",
    "identity",
    "display_name",
    "status",
    "created_at",
    "marking"
   ],
   "properties": {
    "kind": {
     "const": "Entity"
    },
    "schema_version": true,
    "entity_id": {
     "$ref": "#/$defs/EntityId"
    },
    "project_id": {
     "$ref": "#/$defs/ProjectId"
    },
    "entity_type": {
     "$ref": "#/$defs/EntityType"
    },
    "identity": {
     "type": "object"
    },
    "display_name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "status": {
     "enum": [
      "ACTIVE",
      "MERGED",
      "RETIRED"
     ]
    },
    "merged_into": {
     "$ref": "#/$defs/EntityId"
    },
    "status_changed_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "created_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "MERGED"
       }
      }
     },
     "then": {
      "required": [
       "merged_into"
      ]
     },
     "else": {
      "not": {
       "required": [
        "merged_into"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "ACTIVE"
       }
      }
     },
     "then": {
      "not": {
       "required": [
        "status_changed_at"
       ]
      }
     },
     "else": {
      "required": [
       "status_changed_at"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "PERSON"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdPerson"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "ORGANIZATION"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdOrganization"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "REAL_ESTATE"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdRealEstate"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "MOVABLE_PROPERTY"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdMovable"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "EVENT"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdEvent"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "CONFLICT"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdConflict"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "EQUIPMENT"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdEquipment"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "EQUIPMENT_MODEL"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdEquipmentModel"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "CONCEPT"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdConcept"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "THING"
       }
      }
     },
     "then": {
      "properties": {
       "identity": {
        "$ref": "#/$defs/IdThing"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "entity_type": {
        "const": "THING"
       }
      },
      "required": [
       "entity_type"
      ]
     },
     "then": {
      "properties": {
       "schema_version": {
        "const": "core-ontology/0.3"
       }
      }
     }
    }
   ]
  },
  "ForeignId": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scheme",
    "value"
   ],
   "properties": {
    "scheme": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9.]{1,40}$",
     "not": {
      "enum": [
       "ru.inn",
       "ru.ogrn",
       "ru.ogrnip",
       "ru.kpp",
       "ru.cadastral",
       "vin",
       "imo"
      ]
     }
    },
    "value": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "Disambiguator": {
   "type": "string",
   "pattern": "^[a-z0-9_-]{3,64}$"
  },
  "IdPerson": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "surname",
    "given_name"
   ],
   "properties": {
    "surname": {
     "$ref": "#/$defs/NonEmpty"
    },
    "given_name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "patronymic": {
     "$ref": "#/$defs/NonEmpty"
    },
    "birth_date": {
     "$ref": "#/$defs/Date"
    },
    "inn": {
     "type": "string",
     "pattern": "^[0-9]{12}$"
    },
    "ogrnip": {
     "type": "string",
     "pattern": "^[0-9]{15}$"
    },
    "disambiguator": {
     "$ref": "#/$defs/Disambiguator"
    }
   }
  },
  "IdOrganization": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "jurisdiction"
   ],
   "properties": {
    "name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "jurisdiction": {
     "type": "string",
     "pattern": "^[A-Z]{2}$"
    },
    "legal_form": {
     "enum": [
      "LEGAL_ENTITY",
      "BRANCH"
     ]
    },
    "ogrn": {
     "type": "string",
     "pattern": "^[0-9]{13}$"
    },
    "inn": {
     "type": "string",
     "pattern": "^[0-9]{10}$"
    },
    "kpp": {
     "type": "string",
     "pattern": "^[0-9]{9}$"
    },
    "informal": {
     "type": "boolean"
    },
    "disambiguator": {
     "$ref": "#/$defs/Disambiguator"
    },
    "foreign_ids": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ForeignId"
     }
    }
   }
  },
  "IdRealEstate": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "cadastral_number",
    "address"
   ],
   "properties": {
    "cadastral_number": {
     "type": "string",
     "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{6,7}:[0-9]{1,9}$"
    },
    "address": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "IdMovable": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "subtype",
    "description"
   ],
   "properties": {
    "subtype": {
     "enum": [
      "VEHICLE",
      "VESSEL",
      "AIRCRAFT",
      "OTHER"
     ]
    },
    "description": {
     "$ref": "#/$defs/NonEmpty"
    },
    "vin": {
     "type": "string",
     "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
    },
    "imo": {
     "type": "string",
     "pattern": "^[0-9]{7}$"
    },
    "registration": {
     "$ref": "#/$defs/ForeignId"
    }
   }
  },
  "IdEvent": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "date"
   ],
   "properties": {
    "title": {
     "$ref": "#/$defs/NonEmpty"
    },
    "date": {
     "$ref": "#/$defs/Date"
    },
    "place": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "IdConflict": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "started_on"
   ],
   "properties": {
    "title": {
     "$ref": "#/$defs/NonEmpty"
    },
    "started_on": {
     "$ref": "#/$defs/Date"
    },
    "place": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "IdEquipment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "site_id",
    "tag"
   ],
   "properties": {
    "site_id": {
     "type": "string",
     "pattern": "^site_[a-z0-9_]{2,64}$"
    },
    "tag": {
     "$ref": "#/$defs/NonEmpty"
    },
    "description": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "IdEquipmentModel": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "manufacturer",
    "model"
   ],
   "properties": {
    "manufacturer": {
     "$ref": "#/$defs/NonEmpty"
    },
    "model": {
     "$ref": "#/$defs/NonEmpty"
    },
    "description": {
     "$ref": "#/$defs/NonEmpty"
    }
   }
  },
  "IdConcept": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "lang"
   ],
   "properties": {
    "label": {
     "$ref": "#/$defs/NonEmpty"
    },
    "lang": {
     "type": "string",
     "pattern": "^[a-z]{2,3}$"
    },
    "namespace": {
     "type": "string",
     "pattern": "^[a-z0-9_]{2,64}$"
    },
    "disambiguator": {
     "$ref": "#/$defs/Disambiguator"
    }
   }
  },
  "Literal": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "STRING",
      "DATE",
      "QUANTITY",
      "MONEY",
      "IDENTIFIER",
      "BOOLEAN",
      "INTEGER",
      "CLASS_REF"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "STRING"
       }
