      "required": [
       "predicate"
      ]
     },
     "then": {
      "properties": {
       "schema_version": {
        "const": "core-ontology/0.3"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "object": {
        "properties": {
         "literal": {
          "anyOf": [
           {
            "properties": {
             "type": {
              "const": "CLASS_REF"
             }
            },
            "required": [
             "type"
            ]
           },
           {
            "properties": {
             "type": {
              "const": "IDENTIFIER"
             },
             "scheme": {
              "pattern": "^x\\."
             }
            },
            "required": [
             "type",
             "scheme"
            ]
           }
          ]
         }
        },
        "required": [
         "literal"
        ]
       }
      },
      "required": [
       "object"
      ]
     },
     "then": {
      "properties": {
       "schema_version": {
        "const": "core-ontology/0.3"
       }
      }
     }
    }
   ]
  },
