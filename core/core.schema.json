          "minimum": 1
         }
        }
       },
       "quote": {
        "type": "string",
        "minLength": 1
       },
       "quote_sha256": {
        "$ref": "#/$defs/Sha256Hex"
       },
       "graph_node": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "artifact_digest",
         "node_id"
