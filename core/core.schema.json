      "properties": {
       "type": {
        "enum": [
         "ACTION",
         "CONDITION"
        ]
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "id",
       "type",
       "text",
       "anchor"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/UmrNodeId"
       },
       "type": true,
       "anchor": {
        "$ref": "#/$defs/UmrAnchor"
       },
       "text": {
        "$ref": "#/$defs/NonEmpty"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "RELATION"
       }
      }
     },
     "then": {
      "additionalProperties": false,
      "required": [
       "id",
       "type",
       "role",
       "args",
       "anchor"
      ],
      "properties": {
       "id": {
        "$ref": "#/$defs/UmrNodeId"
       },
       "type": true,
       "anchor": {
        "$ref": "#/$defs/UmrAnchor"
       },
       "role": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,40}$"
       },
       "args": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "$ref": "#/$defs/UmrNodeId"
        }
       },
       "parameter": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,64}$"
       },
       "condition": {
        "$ref": "#/$defs/UmrNodeId"
       }
      }
     }
    }
   ]
  },
  "UmrArtifact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "artifact_format",
    "semantic_profile",
    "producer",
    "run_id",
    "inputs",
    "nodes"
   ],
   "properties": {
    "artifact_format": {
     "const": "umr-artifact/0.3"
    },
    "semantic_profile": {
     "$ref": "#/$defs/NonEmpty"
    },
    "producer": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "service_id",
      "version"
     ],
     "properties": {
      "service_id": {
       "$ref": "#/$defs/ServiceId"
      },
      "version": {
       "type": "string",
       "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
     }
    },
    "run_id": {
     "$ref": "#/$defs/RunId"
    },
    "inputs": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/SourceId"
     }
    },
    "nodes": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10000,
     "items": {
      "$ref": "#/$defs/UmrNode"
     }
    }
   }
  },
  "PublicationId": {
   "type": "string",
   "pattern": "^pub:sha256:[0-9a-f]{64}$"
  },
  "Publication": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "publication_id",
    "tenant_id",
    "outlet",
    "canonical_url",
    "text_digest",
    "title",
    "marking",
    "recorded_at"
   ],
   "properties": {
    "kind": {
     "const": "Publication"
    },
    "schema_version": true,
    "publication_id": {
     "$ref": "#/$defs/PublicationId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "outlet": {
     "type": "string",
     "maxLength": 253,
     "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "canonical_url": {
     "type": "string",
     "maxLength": 2000,
     "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?/[^\\s#]*$"
    },
    "text_digest": {
     "type": "string",
     "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
     "$ref": "#/$defs/NonEmpty"
    },
    "published_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    },
    "recorded_at": {
     "$ref": "#/$defs/Timestamp"
    }
   }
  },
  "SchemaDefId": {
   "type": "string",
   "pattern": "^sdf_[a-z0-9_]{2,64}$"
  },
  "IdThing": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "label",
    "lang"
   ],
   "properties": {
    "label": {
     "$ref": "#/$defs/NonEmpty"
    },
    "lang": {
     "type": "string",
     "pattern": "^[a-z]{2,3}$"
    },
    "namespace": {
     "type": "string",
     "pattern": "^[a-z0-9_]{2,64}$"
    },
    "disambiguator": {
     "$ref": "#/$defs/Disambiguator"
    }
   }
  },
  "ClassDef": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "class_id",
    "tenant_id",
    "version",
    "root_type",
    "name",
    "change",
    "marking"
   ],
   "properties": {
    "kind": {
     "const": "ClassDef"
    },
    "schema_version": {
     "const": "core-ontology/0.3"
    },
    "class_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9999
    },
    "root_type": {
     "$ref": "#/$defs/EntityType"
    },
    "name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "parent_class_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "is_abstract": {
     "const": true
    },
    "deprecated": {
     "const": true
    },
    "attributes": {
     "type": "array",
     "minItems": 1,
     "maxItems": 200,
     "items": {
      "$ref": "#/$defs/AttributeDef"
     }
    },
    "change": {
     "$ref": "#/$defs/SchemaChangeInfo"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    }
   }
  },
  "LinkDef": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "link_id",
    "tenant_id",
    "version",
    "predicate_id",
    "name",
    "domain_class_id",
    "range_class_id",
    "cardinality",
    "change",
    "marking"
   ],
   "properties": {
    "kind": {
     "const": "LinkDef"
    },
    "schema_version": {
     "const": "core-ontology/0.3"
    },
    "link_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9999
    },
    "predicate_id": {
     "$ref": "#/$defs/TenantPredicateId"
    },
    "name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "domain_class_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "range_class_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "cardinality": {
     "enum": [
      "ONE",
      "MANY"
     ]
    },
    "symmetric": {
     "const": true
    },
    "deprecated": {
     "const": true
    },
    "change": {
     "$ref": "#/$defs/SchemaChangeInfo"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    }
   }
  },
  "IdentifierDef": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "schema_version",
    "idef_id",
    "tenant_id",
    "version",
    "scheme",
    "name",
    "applies_to_root_type",
    "strength",
    "priority",
    "change",
    "marking"
   ],
   "properties": {
    "kind": {
     "const": "IdentifierDef"
    },
    "schema_version": {
     "const": "core-ontology/0.3"
    },
    "idef_id": {
     "$ref": "#/$defs/SchemaDefId"
    },
    "tenant_id": {
     "$ref": "#/$defs/TenantId"
    },
    "version": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9999
    },
    "scheme": {
     "type": "string",
     "pattern": "^(ru\\.inn|ru\\.ogrn|ru\\.ogrnip|imo|x\\.[a-z][a-z0-9]{1,38})$"
    },
    "name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "applies_to_root_type": {
     "$ref": "#/$defs/EntityType"
    },
    "strength": {
     "enum": [
      "STRONG",
      "WEAK"
     ]
    },
    "priority": {
     "type": "integer",
     "minimum": 1,
     "maximum": 999
    },
    "format": {
     "$ref": "#/$defs/IdentifierFormat"
    },
    "deprecated": {
     "const": true
    },
    "change": {
     "$ref": "#/$defs/SchemaChangeInfo"
    },
    "marking": {
     "$ref": "#/$defs/Marking"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "scheme": {
        "$ref": "#/$defs/TenantScheme"
       }
      }
     },
     "then": {
      "required": [
       "format"
      ]
     },
     "else": {
      "not": {
       "required": [
        "format"
       ]
      },
      "properties": {
       "strength": {
        "const": "STRONG"
       }
      }
     }
    }
   ]
  },
  "TenantPredicateId": {
   "type": "string",
   "pattern": "^x\\.[a-z][a-z_]{1,40}$"
  },
  "TenantScheme": {
   "type": "string",
   "pattern": "^x\\.[a-z][a-z0-9]{1,38}$"
  },
  "SchemaChangeInfo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "description",
    "recorded_at",
    "recorded_by"
   ],
   "properties": {
    "type": {
     "enum": [
      "ADD_CLASS",
      "RENAME_CLASS",
      "DEPRECATE_CLASS",
      "ADD_ATTRIBUTE",
      "CHANGE_ATTRIBUTE",
      "REMOVE_ATTRIBUTE",
      "ADD_LINK",
      "RENAME_LINK",
      "DEPRECATE_LINK",
      "ADD_IDENTIFIER",
      "RENAME_IDENTIFIER",
      "CHANGE_IDENTIFIER_STRENGTH",
      "DEPRECATE_IDENTIFIER"
     ]
    },
    "description": {
     "$ref": "#/$defs/NonEmpty"
    },
    "migration_note": {
     "$ref": "#/$defs/NonEmpty"
    },
    "recorded_at": {
     "$ref": "#/$defs/Timestamp"
    },
    "recorded_by": {
     "$ref": "#/$defs/ActorId"
    }
   }
  },
  "AttributeDef": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "predicate_id",
    "name",
    "value_type",
    "cardinality",
    "required"
   ],
   "properties": {
    "predicate_id": {
     "$ref": "#/$defs/TenantPredicateId"
    },
    "name": {
     "$ref": "#/$defs/NonEmpty"
    },
    "value_type": {
     "enum": [
      "STRING",
      "DATE",
      "QUANTITY",
      "MONEY",
      "IDENTIFIER",
      "BOOLEAN",
      "INTEGER"
     ]
    },
    "cardinality": {
     "enum": [
      "ONE",
      "MANY"
     ]
    },
    "required": {
     "type": "boolean"
    },
    "unit": {
     "type": "string",
     "pattern": "^[A-Za-z%/0-9]{1,16}$"
    },
    "scheme": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9.]{1,40}$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "value_type": {
        "const": "QUANTITY"
       }
      }
     },
     "then": {
      "required": [
       "unit"
      ]
     },
     "else": {
      "not": {
       "required": [
        "unit"
       ]
      }
     }
    },
    {
     "if": {
      "properties": {
       "value_type": {
        "const": "IDENTIFIER"
       }
      }
     },
     "then": {
      "required": [
       "scheme"
      ]
     },
     "else": {
      "not": {
       "required": [
        "scheme"
       ]
      }
     }
    }
   ]
  },
  "IdentifierFormat": {
   "type": "array",
   "minItems": 1,
   "maxItems": 16,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "chars",
       "min",
       "max"
      ],
      "properties": {
       "chars": {
        "enum": [
         "DIGIT",
         "UPPER",
         "LOWER",
         "ALNUM",
         "ALNUM_UPPER"
        ]
       },
       "min": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64
       },
       "max": {
        "type": "integer",
        "minimum": 1,
        "maximum": 64
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "lit"
      ],
      "properties": {
       "lit": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./-]$"
       }
      }
     }
    ]
   }
  }
 }
}
